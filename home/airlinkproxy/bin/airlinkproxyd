"""main airlinkproxy server program

Parses the command line and the configuration file, points the shared logger at
syslog, wires up the database, the REST server and the service, and then runs
the main loop on this thread.
"""

import optparse
import os
import sys

from typing import Any, Dict, Optional

import configobj

import server.server

from monitor import log
from monitor.database import Database
from monitor.service import Service

AIRLINK_PROXY_VERSION = "1.0"

class CantOpenConfigFile(Exception):
    pass

class CantParseConfigFile(Exception):
    pass

def get_configuration(config_file: str) -> Dict[str, Any]:
    try:
        config_dict = configobj.ConfigObj(config_file, file_error=True, encoding='utf-8')
    except IOError:
        raise CantOpenConfigFile("Unable to open configuration file %s" % config_file)
    except configobj.ConfigObjError:
        raise CantParseConfigFile("Error parsing configuration file %s" % config_file)

    return config_dict

def dump_database(db_file: str) -> None:
    # Never let a dump create the file: sqlite3.connect() would create an
    # empty one, and startup skips Database.create for a file that exists,
    # leaving every save to fail against a database with no Reading table.
    if not os.path.exists(db_file):
        print('No such database: %s' % db_file)
        sys.exit(1)
    start = Service.utc_now()
    database: Database = Database(db_file)
    print('----------------------------')
    print('* Dumping current reading  *')
    print('----------------------------')
    for reading in database.fetch_current_readings():
        print(reading)
        print('---')
    print('----------------------------')
    print('* Dumping two-minute avg   *')
    print('----------------------------')
    for reading in database.fetch_two_minute_readings():
        print(reading)
        print('---')
    print('----------------------------')
    print('* Dumping archive readings *')
    print('----------------------------')
    for reading in database.fetch_archive_readings():
        print(reading)
        print('---')
    print('Dumped database in %d seconds.' % (Service.utc_now() - start).seconds)

def main() -> None:
    usage = """%prog [--help] [--dump] [--pidfile <pidfile>] <airlinkproxy-conf-file>"""
    parser: optparse.OptionParser = optparse.OptionParser(usage=usage)

    parser.add_option('-p', '--pidfile', dest='pidfile', action='store',
                      type=str, default=None,
                      help='When running as a daemon, pidfile in which to write pid.  Default is None.')
    parser.add_option('-d', '--dump', dest='dump', action='store_true', default=False,
                      help='Dump database and then exit. Default is False')

    (options, args) = parser.parse_args()

    if len(args) != 1:
        parser.error('Usage: [--pidfile <pidfile>] [--dump] <airlinkproxy-conf-file>')

    conf_file: str = os.path.abspath(args[0])
    config_dict    = get_configuration(conf_file)

    debug          : bool           = bool(int(config_dict.get('debug', 0)))
    log_to_stdout  : bool           = bool(int(config_dict.get('log-to-stdout', 0)))
    service_name   : str            = config_dict.get('service-name', 'airlink-proxy')
    hostname       : Optional[str]  = config_dict.get('hostname', None)
    port           : int            = int(config_dict.get('port', 80))
    server_port    : int            = int(config_dict.get('server-port', 8040))
    timeout_secs   : int            = int(config_dict.get('timeout-secs', 1))
    pollfreq_secs  : int            = int(config_dict.get('poll-freq-secs', 5))
    pollfreq_offset: int            = int(config_dict.get('poll-freq-offset', 0))
    arcint_secs    : int            = int(config_dict.get('archive-interval-secs', 300))
    db_file        : Optional[str]  = config_dict.get('database-file', None)

    log.reconfigure(service_name, log_to_stdout=log_to_stdout, debug_mode=debug)

    log.info('debug          : %r'    % debug)
    log.info('log_to_stdout  : %r'    % log_to_stdout)
    log.info('conf_file      : %s'    % conf_file)
    log.info('Version        : %s'    % AIRLINK_PROXY_VERSION)
    log.info('host:port      : %s:%s' % (hostname, port))
    log.info('server_port    : %s'    % server_port)
    log.info('timeout_secs   : %d'    % timeout_secs)
    log.info('pollfreq_secs  : %d'    % pollfreq_secs)
    log.info('pollfreq_offset: %d'    % pollfreq_offset)
    log.info('arcint_secs    : %d'    % arcint_secs)
    log.info('db_file        : %s'    % db_file)
    log.info('service_name   : %s'    % service_name)
    log.info('pidfile        : %s'    % options.pidfile)

    if options.dump is True:
        if not db_file:
            parser.error('database-file must be specified in the config file')
        assert db_file
        dump_database(db_file)
        sys.exit(0)

    if not hostname:
        parser.error('hostname must be specified in the config file')

    if not db_file:
        parser.error('database-file must be specified in the config file')

    if pollfreq_secs <= 0:
        parser.error('poll-freq-secs must be greater than zero')

    if arcint_secs <= 0:
        parser.error('archive-interval-secs must be greater than zero')

    # arcint must be a multiple of pollfreq
    if arcint_secs % pollfreq_secs != 0:
        parser.error('archive-interval-secs must be a multiple of poll-freq-secs')

    # The offset shifts each poll later within its poll-freq-secs window; at or
    # beyond that window it would slow polling to a multiple of poll-freq-secs.
    if pollfreq_offset < 0 or pollfreq_offset >= pollfreq_secs:
        parser.error('poll-freq-offset must be at least zero and less than poll-freq-secs')

    if options.pidfile is not None:
        pid: str = str(os.getpid())
        with open(options.pidfile, 'w') as f:
            f.write(pid + '\n')
            f.flush()
            os.fsync(f.fileno())

    # Create database if it does not yet exist.
    assert db_file
    database: Database
    if not os.path.exists(db_file):
        log.debug('Creating database: %s' % db_file)
        database = Database.create(db_file)
    else:
        database = Database(db_file)

    assert hostname
    airlinkproxy_service = Service(hostname, port, timeout_secs, pollfreq_secs,
                                   pollfreq_offset, arcint_secs, database)

    log.debug('Starting server on port %d.' % server_port)
    server.server.serve_requests(server_port, db_file, arcint_secs)

    log.debug('Starting mainloop.')
    airlinkproxy_service.do_loop()

if __name__ == "__main__":
    main()
